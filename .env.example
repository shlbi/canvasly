# Vercel/server settings. No NEXT_PUBLIC_ prefixes; no student passwords/tokens.
APP_URL=https://www.trycanvasly.com
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
APP_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
OPENAI_API_KEY=REPLACE_WITH_PAID_PROVIDER_KEY
STRIPE_SECRET_KEY=REPLACE_WITH_SERVER_KEY_PREFER_RESTRICTED
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_ID=price_REPLACE_ME
WORKER_URL=https://worker.trycanvasly.com
WORKER_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
# Optional: default gpt-4.1-mini. No ChatGPT subscription credentials are used.
# OPENAI_MODEL=gpt-4.1-mini
# Optional official Canvas OAuth: only usable where an institution enables the registration.
# A global key is not universal authorization. These are credentials, not an admissions allowlist.
# CANVAS_CLIENT_ID=
# CANVAS_CLIENT_SECRET=
# CANVAS_OAUTH_CLIENTS_JSON={"school.instructure.com":{"client_id":"issued","client_secret":"issued"}}
# CANVAS_FILE_HOSTS=optional.exact.authorized.storage.hostname
