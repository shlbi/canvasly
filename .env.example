# Canvasly v2 / 0.4: no founder OPENAI_API_KEY is used by the new workspace.
# Local source preview. Use 127.0.0.1, NOT localhost, for the OAuth callback.
CANVASLY_MODE=local
APP_URL=http://127.0.0.1:3000
PORT=3000
# Local mode creates a private .canvasly/encryption.key automatically.
# Hosted: set a stable random 32-byte key as 64 hex characters, never commit it.
# APP_ENCRYPTION_KEY=
# CANVASLY_DATA_DIR=absolute-path-to-private-local-data

# Exact approved school hostnames, comma-separated. No schemes, paths or wildcards.
CANVAS_ALLOWED_HOSTS=your-school.instructure.com
# Multi-user Canvas OAuth keys are issued/enabled by each institution's Canvas admin.
# Register APP_URL + /canvas/callback at the institution.
CANVAS_OAUTH_CLIENTS_JSON={}
# Example (replace placeholders, keep as ONE line; never commit real values):
# CANVAS_OAUTH_CLIENTS_JSON={"your-school.instructure.com":{"client_id":"ISSUED_ID","client_secret":"ISSUED_SECRET"}}
CANVAS_FILE_HOSTS=
# ONLY to test your OWN account locally before OAuth. Never student onboarding.
CANVAS_PERSONAL_TEST=false

# Hosted mode only. Sign-in and plan usage require actual OpenAI approval.
# An environment flag does not grant access. Local dynamic registration uses neither.
# CANVASLY_MODE=hosted
# APP_URL=https://your-actual-domain.example
# CHATGPT_CLIENT_ID=oaiapp_issued-for-your-app
# CHATGPT_CLIENT_SECRET=only-if-issued-for-a-confidential-client
# CHATGPT_TOKEN_AUTH_METHOD=none
CHATGPT_PLAN_USAGE_ENABLED=false

# Hosted workspace storage. Run supabase/v2.sql, not just the original schema.
# Supabase Auth/publishable keys are not needed for v2 ChatGPT-based identity.
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_server-only-key

# Private beta allowlist. Blank permits any approved, verified sign-in.
ALLOWED_EMAILS=
# Counts model calls, not assignments. A draft normally takes three calls.
DAILY_AI_LIMIT=48
# Hosted worker authentication. Use a random long value; add an external scheduler
# or run `npm run worker` on an always-on host. Merely setting this does not run jobs.
# CRON_SECRET=
