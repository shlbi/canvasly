# Required: Supabase Project Settings > API Keys. Legacy anon/service_role keys work.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key
# Required: https://platform.openai.com/api-keys (API billing is separate).
OPENAI_API_KEY=your-openai-api-key
# Required: generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=replace-with-64-hex-characters
# Required: your final app origin; no trailing slash. Local development: http://localhost:3000
APP_URL=http://localhost:3000
# Required: exact, comma-separated school Canvas hostnames; no paths or wildcards.
CANVAS_ALLOWED_HOSTS=your-school.instructure.com
# Recommended: limit a private beta to these email addresses; blank opens registration.
ALLOWED_EMAILS=
# Optional model and cost limits. Each plan/write/review/revision consumes one call.
OPENAI_MODEL=gpt-4.1-mini
DAILY_AI_LIMIT=24
# Optional extra, exact Canvas file-storage hosts beyond Canvas, *.instructure.com and *.amazonaws.com.
CANVAS_FILE_HOSTS=
