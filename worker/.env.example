# Copy to worker/.env on the worker host only. Keep .env out of Git.
APP_URL=https://www.trycanvasly.com
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET
APP_ENCRYPTION_KEY=SAME_64_HEX_CHARACTERS_AS_VERCEL
OPENAI_API_KEY=YOUR_PAID_OPENAI_API_KEY
WORKER_SECRET=SAME_LONG_RANDOM_SECRET_AS_VERCEL
WORKER_HOST=worker.trycanvasly.com
# Operational browser slots, not a student subscription allowance.
BROWSER_CONCURRENCY=2
# Optional model override and approved institution API registrations:
# OPENAI_MODEL=gpt-4.1-mini
# CANVAS_CLIENT_ID=
# CANVAS_CLIENT_SECRET=
# CANVAS_OAUTH_CLIENTS_JSON={"school.instructure.com":{"client_id":"issued","client_secret":"issued"}}
